EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY_HERE

POSTHOG_PROJECT_TOKEN=phc_YOUR_POSTHOG_PROJECT_TOKEN_HERE
POSTHOG_HOST=https://app.posthog.com

# Stream — public API key is fine on the client, secret stays server-only.
EXPO_PUBLIC_STREAM_API_KEY=YOUR_STREAM_API_KEY_HERE
STREAM_API_KEY=YOUR_STREAM_API_KEY_HERE
STREAM_API_SECRET=YOUR_STREAM_API_SECRET_HERE

# Vision Agents — Python service in /vision-agent reads these from this file.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY_HERE
# URL of the running Vision Agents HTTP server (uv run main.py serve).
VISION_AGENT_URL=http://127.0.0.1:8000

# Copy this file to `.env` locally and fill in real values.
