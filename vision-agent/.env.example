# vision-agent reads its env from this file FIRST, then falls back to the
# parent app's `.env` and `.env.local` (one level up). So in practice you
# only need to fill in the parent .env / .env.local — these names exist as
# documentation for what the Python service requires.

# Stream Edge (transport). Reused from the parent app's .env.
STREAM_API_KEY=
STREAM_API_SECRET=

# OpenAI Realtime (LLM + voice).
OPENAI_API_KEY=
VISION_AGENT_URL=http://127.0.0.1:8000